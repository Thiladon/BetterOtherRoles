<Project>
    <!--
        AmongStat server address and shared host code, read from the .env file next to the solution (never committed,
        see .gitignore) and built into the DLL, masked: BetterOtherRoles.Modules.Summary.AmongStatBuildSecrets.
        Without a .env file, both are empty and the statistics are not sent.

        .env:
            AMONGSTAT_SERVER=https://...
            AMONGSTAT_CODE=...
    -->
    <UsingTask TaskName="WriteAmongStatSecrets" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <EnvFile ParameterType="System.String" Required="true" />
            <OutputFile ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Linq" />
            <Using Namespace="System.Text" />
            <Code Type="Fragment" Language="cs"><![CDATA[
                var server = string.Empty;
                var code = string.Empty;
                if (File.Exists(EnvFile))
                {
                    foreach (var line in File.ReadAllLines(EnvFile))
                    {
                        var text = line.Trim();
                        var equal = text.IndexOf('=');
                        if (text.Length == 0 || text.StartsWith("#") || equal < 0) continue;

                        var name = text.Substring(0, equal).Trim();
                        var value = text.Substring(equal + 1).Trim().Trim('"');
                        if (name == "AMONGSTAT_SERVER") server = value;
                        else if (name == "AMONGSTAT_CODE") code = value;
                    }
                }

                var key = Encoding.UTF8.GetBytes("BOR-MiraAPI/AmongStat");
                Func<string, string> mask = s => string.Join(", ",
                    Encoding.UTF8.GetBytes(s).Select((b, i) => "0x" + (b ^ key[i % key.Length]).ToString("X2")));

                var source = new StringBuilder()
                    .AppendLine("// <auto-generated/>")
                    .AppendLine("namespace BetterOtherRoles.Modules.Summary;")
                    .AppendLine()
                    .AppendLine("internal static class AmongStatBuildSecrets")
                    .AppendLine("{")
                    .AppendLine("    internal static readonly byte[] Key = [" + string.Join(", ", key.Select(b => "0x" + b.ToString("X2"))) + "];")
                    .AppendLine("    internal static readonly byte[] Server = [" + mask(server) + "];")
                    .AppendLine("    internal static readonly byte[] Code = [" + mask(code) + "];")
                    .AppendLine("}")
                    .ToString();

                // Written only when it changes, so that the build stays incremental.
                if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != source)
                {
                    Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
                    File.WriteAllText(OutputFile, source);
                }
            ]]></Code>
        </Task>
    </UsingTask>

    <Target Name="AmongStatSecrets" BeforeTargets="CoreCompile">
        <PropertyGroup>
            <AmongStatSecretsFile>$(IntermediateOutputPath)AmongStatBuildSecrets.g.cs</AmongStatSecretsFile>
        </PropertyGroup>
        <WriteAmongStatSecrets EnvFile="$(MSBuildThisFileDirectory).env" OutputFile="$(AmongStatSecretsFile)" />
        <ItemGroup>
            <Compile Include="$(AmongStatSecretsFile)" />
        </ItemGroup>
    </Target>
</Project>
