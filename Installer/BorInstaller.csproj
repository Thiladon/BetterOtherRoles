<Project Sdk="Microsoft.NET.Sdk">
    <!-- Installer and updater helper of BOR-MiraAPI: a small Windows window, .NET Framework 4.8 (on every Windows 10/11, nothing to install). -->
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net48</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <AssemblyName>BOR-MiraAPI-Installer</AssemblyName>
        <RootNamespace>BorInstaller</RootNamespace>
        <ImplicitUsings>disable</ImplicitUsings>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <PackageReadmeFile></PackageReadmeFile>
        <PackageLicenseFile></PackageLicenseFile>
        <Version>1.0.0</Version>
        <!-- Icon of Among Us (taken from Among Us.exe with icoextract, 16 to 256 px). -->
        <ApplicationIcon>Installer.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
        <Reference Include="System.IO.Compression" />
        <Reference Include="System.IO.Compression.FileSystem" />
        <Reference Include="System.Runtime.Serialization" />
    </ItemGroup>
</Project>
